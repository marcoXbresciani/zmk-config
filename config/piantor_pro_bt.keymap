//
// Piantor Pro BT — ZMK Keymap
// OS layout : Italian (Windows)
// Base      : QWERTY
// Layers    : 12 (L0-L11, 5 conditional layers)

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

// ── Italian layout aliases ────────────────────────────────────────────────────
#define IT_AGRV  SQT
#define IT_EGRV  LBKT
#define IT_OGRV  SEMI
#define IT_IGRV  EQUAL
#define IT_UGRV  NON_US_HASH
#define IT_PLUS  RBKT
#define IT_APOS  MINUS
#define IT_MINUS FSLH
#define IT_BKSL  GRAVE
#define IT_LT    NON_US_BACKSLASH
#define IT_AT    RA(SEMI)
#define IT_EUR   RA(E)
#define IT_HASH  RA(IT_AGRV)
#define IT_LBKT  RA(LBKT)
#define IT_RBKT  RA(RBKT)
#define IT_LCBR  LS(RA(LBKT))
#define IT_RCBR  LS(RA(RBKT))

// ── Shortcuts ─────────────────────────────────────────────────────────────────
#define SNIP     LS(LG(S))
#define MMUT     LG(LA(K))
#define IME      LG(SPACE)

// ── Layer-tap tuning ──────────────────────────────────────────────────────────
// Match QMK LT(layer, kc) baseline timing and enable double-tap-hold repeat.
&lt {
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
    require-prior-idle-ms = <150>;
};

/ {
    behaviors {
        td_lshft: td_lshft {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSHFT>, <&kp CAPS>;
        };

        td_rshft: td_rshft {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp RSHFT>, <&kp CAPS>;
        };
    };

    macros {
        // Windows Alt Code macros. Requires Num Lock ON on the host.
        m_a_grv: m_a_grv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>,
                       <&macro_tap &kp KP_N0 &kp KP_N1 &kp KP_N9 &kp KP_N2>,
                       <&macro_release &kp LALT>;
        };

        m_e_grv: m_e_grv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>,
                       <&macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N0 &kp KP_N0>,
                       <&macro_release &kp LALT>;
        };

        m_e_acu: m_e_acu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>,
                       <&macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N0 &kp KP_N1>,
                       <&macro_release &kp LALT>;
        };

        m_i_grv: m_i_grv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>,
                       <&macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N0 &kp KP_N4>,
                       <&macro_release &kp LALT>;
        };

        m_o_grv: m_o_grv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>,
                       <&macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N1 &kp KP_N0>,
                       <&macro_release &kp LALT>;
        };

        m_u_grv: m_u_grv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>,
                       <&macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N1 &kp KP_N7>,
                       <&macro_release &kp LALT>;
        };

        m_tilde: m_tilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>,
                       <&macro_tap &kp KP_N1 &kp KP_N2 &kp KP_N6>,
                       <&macro_release &kp LALT>;
        };

        m_grave: m_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>,
                       <&macro_tap &kp KP_N9 &kp KP_N6>,
                       <&macro_release &kp LALT>;
        };

        // Emacs C-x 8 RET <4-digit Unicode hex codepoint> RET macros.
        em_a_grv: em_a_grv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LC(X) &kp N8 &kp RETURN &kp N0 &kp N0 &kp C &kp N0 &kp RETURN>;
        };

        em_e_grv: em_e_grv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LC(X) &kp N8 &kp RETURN &kp N0 &kp N0 &kp C &kp N8 &kp RETURN>;
        };

        em_e_acu: em_e_acu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LC(X) &kp N8 &kp RETURN &kp N0 &kp N0 &kp C &kp N9 &kp RETURN>;
        };

        em_i_grv: em_i_grv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LC(X) &kp N8 &kp RETURN &kp N0 &kp N0 &kp C &kp C &kp RETURN>;
        };

        em_o_grv: em_o_grv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LC(X) &kp N8 &kp RETURN &kp N0 &kp N0 &kp D &kp N2 &kp RETURN>;
        };

        em_u_grv: em_u_grv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LC(X) &kp N8 &kp RETURN &kp N0 &kp N0 &kp D &kp N9 &kp RETURN>;
        };

        em_tilde: em_tilde {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LC(X) &kp N8 &kp RETURN &kp N0 &kp N0 &kp N7 &kp E &kp RETURN>;
        };

        em_grave: em_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LC(X) &kp N8 &kp RETURN &kp N0 &kp N0 &kp N6 &kp N0 &kp RETURN>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        bt_layer {
            if-layers = <1 3>;          // SPC + DEL -> BT
            then-layer = <7>;
        };
        up_egrv_layer {
            if-layers = <2 4>;          // ENT + BSPC -> UP_EGRV
            then-layer = <8>;
        };
        up_eacu_layer {
            if-layers = <4 6>;          // BSPC + ESC -> UP_EACU
            then-layer = <9>;
        };
        emacs_egrv_layer {
            if-layers = <2 6>;          // ENT + ESC -> UP_E_EGRV
            then-layer = <10>;
        };
        emacs_eacu_layer {
            if-layers = <2 4 6>;        // ENT + BSPC + ESC -> UP_E_EACU
            then-layer = <11>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
   &kp LALT   &kp Q      &kp W      &kp E      &kp R      &kp T            &kp Y      &kp U      &kp I      &kp O      &kp P      &kp IT_APOS
   &kp LCTRL  &kp A      &kp S      &kp D      &kp F      &kp G            &kp H      &kp J      &kp K      &kp L      &kp SNIP   &kp IT_PLUS
   &td_lshft  &kp Z      &kp X      &kp C      &kp V      &kp B            &kp N      &kp M      &kp COMMA  &kp DOT    &kp IT_MINUS &td_rshft
                                    &lt 5 TAB  &lt 3 DEL  &lt 1 SPACE      &lt 2 RET  &lt 4 BSPC &lt 6 ESC
            >;
        };

        layer_1 {
            display-name = "ARROWS";
            bindings = <
   &trans     &trans     &trans     &trans     &trans     &trans           &trans     &kp IT_UGRV &kp IT_IGRV &kp IT_OGRV &trans    &m_tilde
   &trans     &trans     &trans     &trans     &trans     &trans           &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &kp K_MUTE &trans
   &trans     &trans     &trans     &trans     &trans     &trans           &trans     &trans     &trans     &trans     &trans     &trans
                                    &trans     &trans     &trans           &trans     &trans     &trans
            >;
        };

        layer_2 {
            display-name = "SYMBOLS";
            bindings = <
   &kp LGUI    &kp IT_AT   &kp IT_HASH &kp IT_EGRV &trans      &trans              &trans      &trans      &trans      &trans      &trans      &trans
   &trans      &kp IT_AGRV &trans      &trans      &trans      &trans              &trans      &trans      &trans      &trans      &trans      &trans
   &trans      &kp IT_LT  &kp IT_BKSL &kp IT_EUR &trans  &trans           &trans     &trans     &trans     &trans     &trans     &trans
                                    &trans     &kp INS    &trans           &trans     &trans     &trans
            >;
        };

        layer_3 {
            display-name = "PAGES";
            bindings = <
   &trans      &trans      &trans      &trans      &trans      &trans              &trans      &m_u_grv    &m_i_grv    &m_o_grv    &trans      &m_grave
   &trans     &trans     &trans     &trans     &trans     &trans           &kp HOME   &kp PG_DN  &kp PG_UP  &kp END    &kp MMUT   &trans
   &trans     &trans     &trans     &trans     &trans     &trans           &trans     &trans     &trans     &trans     &trans     &trans
                                    &trans     &trans     &trans           &trans     &trans     &trans
            >;
        };

        layer_4 {
            display-name = "NUMS";
            bindings = <
   &trans     &kp N0     &kp N1     &kp N2     &kp N3     &trans           &trans     &trans     &trans     &trans     &trans     &trans
   &trans      &m_a_grv    &kp N4      &kp N5      &kp N6      &trans              &trans      &trans      &trans      &trans      &trans      &trans
   &trans     &trans     &kp N7     &kp N8     &kp N9     &trans           &trans     &trans     &trans     &trans     &trans     &trans
                                    &trans     &trans     &trans           &trans     &trans     &trans
            >;
        };

        layer_5 {
            display-name = "BRACKS";
            bindings = <
   &trans      &trans      &trans      &trans      &trans      &trans              &trans      &em_u_grv   &em_i_grv   &em_o_grv   &trans      &em_tilde
   &trans     &trans     &trans     &trans     &trans     &trans           &kp IT_LCBR &kp IT_LBKT &kp IT_RBKT &kp IT_RCBR &kp IME    &trans
   &trans     &trans     &trans     &trans     &trans     &trans           &trans     &trans     &trans     &trans     &trans     &trans
                                    &trans     &trans     &trans           &trans     &trans     &trans
            >;
        };

        layer_6 {
            display-name = "FKEYS";
            bindings = <
   &trans     &trans     &kp F1     &kp F2     &kp F3     &kp F10          &trans     &trans     &trans     &trans     &trans     &trans
   &trans      &em_a_grv   &kp F4      &kp F5      &kp F6      &kp F11             &trans      &trans      &trans      &trans      &trans      &trans
   &trans     &trans     &kp F7     &kp F8     &kp F9     &kp F12          &trans     &trans     &trans     &trans     &trans     &trans
                                    &trans     &trans     &trans           &trans     &trans     &trans
            >;
        };

        layer_7 {
            display-name = "BT";
            bindings = <
   &trans      &trans      &trans      &trans      &trans      &trans              &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &em_grave
   &trans     &trans     &trans     &trans     &trans     &trans           &trans     &trans     &trans     &trans     &trans     &trans
   &trans     &trans     &trans     &trans     &trans     &trans           &trans     &trans     &trans     &trans     &studio_unlock &rgb_ug RGB_TOG
                                    &trans     &trans     &trans           &bt BT_CLR &sys_reset &bootloader
            >;
        };

        layer_8 {
            display-name = "UP_EGRV";
            bindings = <
   &trans     &trans     &trans     &m_e_grv   &trans     &trans           &trans     &trans     &trans     &trans     &trans     &trans
   &trans      &trans      &trans      &trans      &trans      &trans              &trans      &trans      &trans      &trans      &trans      &trans
   &trans     &trans     &trans     &trans     &trans     &trans           &trans     &trans     &trans     &trans     &trans     &trans
                                    &trans     &trans     &trans           &trans     &trans     &trans
            >;
        };

        layer_9 {
            display-name = "UP_EACU";
            bindings = <
   &trans      &trans      &trans      &m_e_acu    &trans      &trans              &trans      &trans      &trans      &trans      &trans      &trans
   &trans     &trans     &trans     &trans     &trans     &trans           &trans     &trans     &trans     &trans     &trans     &trans
   &trans     &trans     &trans     &trans     &trans     &trans           &trans     &trans     &trans     &trans     &trans     &trans
                                    &trans     &trans     &trans           &trans     &trans     &trans
            >;
        };

        layer_10 {
            display-name = "UP_E_EGRV";
            bindings = <
   &trans      &trans      &trans      &em_e_grv   &trans      &trans              &trans      &trans      &trans      &trans      &trans      &trans
   &trans     &trans     &trans     &trans     &trans     &trans           &trans     &trans     &trans     &trans     &trans     &trans
   &trans     &trans     &trans     &trans     &trans     &trans           &trans     &trans     &trans     &trans     &trans     &trans
                                    &trans     &trans     &trans           &trans     &trans     &trans
            >;
        };

        layer_11 {
            display-name = "UP_E_EACU";
            bindings = <
   &trans      &trans      &trans      &em_e_acu   &trans      &trans              &trans      &trans      &trans      &trans      &trans      &trans
   &trans     &trans     &trans     &trans     &trans     &trans           &trans     &trans     &trans     &trans     &trans     &trans
   &trans     &trans     &trans     &trans     &trans     &trans           &trans     &trans     &trans     &trans     &trans     &trans
                                    &trans     &trans     &trans           &trans     &trans     &trans
            >;
        };
    };
};
